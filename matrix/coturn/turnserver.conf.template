# coturn for legacy Matrix 1:1 calls (Element Web old calls, FluffyChat).
# Element X uses LiveKit instead. Rendered by bootstrap.sh.
# Auth is by shared secret with Synapse — both sides must match.
use-auth-secret
static-auth-secret=${COTURN_SECRET}
realm=${BASE_DOMAIN}

listening-port=${COTURN_PORT}

# Relay port range — forward these as UDP on the router.
min-port=${COTURN_RELAY_MIN}
max-port=${COTURN_RELAY_MAX}

# Lock down relaying. Without these denied-peer rules a TURN server is an open
# proxy into your LAN.
no-multicast-peers
no-tcp-relay
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
# The rest of the non-public space: coturn runs on the host network, where loopback holds
# services published on 127.0.0.1; IPv4-mapped IPv6 would otherwise slip past the IPv4 rules.
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=224.0.0.0-255.255.255.255
denied-peer-ip=::1
denied-peer-ip=::ffff:0.0.0.0-::ffff:255.255.255.255
denied-peer-ip=64:ff9b::-64:ff9b::ffff:ffff
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
no-cli
log-file=stdout
