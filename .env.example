###############################################################################
# meowstack — single configuration file for the whole stack.
#
#   cp .env.example .env && ./bootstrap.sh
#
# bootstrap.sh fills in every GENERATED value below and renders the config files
# that cannot read environment variables themselves (Synapse, coturn, LiveKit,
# Element, Caddy). Re-running it is safe: it never overwrites a value you set.
#
# Anything marked REQUIRED must be set by hand before the first run.
# Everything else has a working default.
#
# Quote any value containing spaces: HUB_NAME="My Hub". bootstrap.sh sources
# this file, so an unquoted space is read as a command.
###############################################################################

# ---------------------------------------------------------------- identity ---

# REQUIRED. The bare domain. Every hostname below is derived from it, and it is
# baked into Matrix user IDs forever — changing it later orphans every account.
BASE_DOMAIN=example.com

# Hostnames. Defaults are derived from BASE_DOMAIN; override only if your DNS
# is laid out differently. All of them need an A record pointing at this server.
CLOUD_HOST=cloud.${BASE_DOMAIN}
PHOTOS_HOST=photos.${BASE_DOMAIN}
MATRIX_HOST=matrix.${BASE_DOMAIN}
TURN_HOST=turn.${BASE_DOMAIN}

# REQUIRED for Let's Encrypt. Used only for expiry warnings.
ACME_EMAIL=admin@example.com

# Timezone for containers that care (Nextcloud cron, logs).
TZ=Europe/Oslo

# ------------------------------------------------------------- what to run ---

# Comma-separated. Services with no profile (caddy, hub-stats) always run.
#   nextcloud  immich  matrix  metube
# Drop what you don't want — e.g. COMPOSE_PROFILES=nextcloud,immich,crypto
# Optional extras: n8n (automation UI), ollama (local LLM for it),
#   helper (Telegram bot: health alerts, links, downloads, logins).
COMPOSE_PROFILES=nextcloud,immich,matrix,metube,crypto,helper

# GPU: the default compose file requests no GPU, so it runs anywhere. To enable
# NVENC transcoding (immich-server) and CUDA ML (immich-machine-learning), you
# need the NVIDIA container runtime installed, then set:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
COMPOSE_FILE=docker-compose.yml

# ------------------------------------------------------------------ storage ---

# Bulk data — put this on your big disk. Holds Nextcloud files, Immich uploads,
# Matrix media + database, and MeTube downloads. Must exist and be writable.
DATA_ROOT=/srv/media

# Individual locations, derived from DATA_ROOT. Override to split across disks.
NEXTCLOUD_DATA=${DATA_ROOT}/nextcloud
IMMICH_UPLOAD=${DATA_ROOT}/immich
IMMICH_DB_DATA=./immich/postgres
MATRIX_MEDIA=${DATA_ROOT}/matrix/media
MATRIX_DB_DATA=${DATA_ROOT}/matrix/postgres
METUBE_DOWNLOADS=${DATA_ROOT}/youtube
# Plex libraries (Movies / TV Shows / Anime). Mounted into Nextcloud as the
# folder "Plex", so moving a file there puts it in Plex. See docs/PLEX.md.
PLEX_MEDIA=${DATA_ROOT}/plex

# Optional: an existing photo folder mounted read-only into Immich as an
# "external library". Point it at DATA_ROOT itself if you have nothing separate.
PHOTOS_EXTERNAL=${DATA_ROOT}/Photos

# ------------------------------------------------------------ secret paths ---
#
# These are URL path prefixes that act as the only access control on services
# with no login of their own. The defaults below are readable placeholders —
# bootstrap.sh replaces each with "<name>-<random hex>" on first run. Treat the
# resulting URLs as passwords.

# https://${BASE_DOMAIN}/${DASHBOARD_PATH}/
# Shown as the hub page heading. First word plain, the rest highlighted.
HUB_NAME="Home Hub"

DASHBOARD_PATH=hub
# https://${BASE_DOMAIN}/${METUBE_PATH}/
METUBE_PATH=dl
# https://${MATRIX_HOST}/${MATRIXRTC_PATH}/ (Element Call)
MATRIXRTC_PATH=call
# https://${BASE_DOMAIN}/${AWG_ADMIN_PATH}/ (VPN peers)
AWG_ADMIN_PATH=awg

# Crypto tracker UI. Behind basic auth as CRYPTO_ADMIN_USER, because the page
# stores a Telegram bot token — a secret path alone is not enough.
# https://${BASE_DOMAIN}/${CRYPTO_PATH}/
CRYPTO_PATH=crypto

# n8n workflow automation. Protected by n8n's own account login rather than
# basic auth, because it has real accounts (and optional 2FA) and a second
# credential prompt breaks the editor's websocket.
# https://${BASE_DOMAIN}/${N8N_PUBLIC_PATH}/
N8N_PUBLIC_PATH=n8n

# ESP32 sensor dashboard. No login: it only shows room temperature/humidity.
# The ESP32 posts to https://${BASE_DOMAIN}/${SENSOR_PATH}/api/readings.
SENSOR_PATH=sensor

# Helper bot (profile `helper`, docs/HELPER.md). Two routes on the root domain:
#   https://${BASE_DOMAIN}/${BOT_APP_PATH}/    the Telegram Mini App (members).
#       No login of its own: every call is authenticated by Telegram's signed
#       initData, so only people who opened it from the bot get in.
#   https://${BASE_DOMAIN}/${BOT_ADMIN_PATH}/  the owner's admin page (hub card
#       "Bots"), behind basic auth as BOT_ADMIN_USER. The password is generated
#       into ./secrets/bot-admin-password (the bot also hands it out under /pass).
BOT_APP_PATH=bot
BOT_ADMIN_PATH=botadmin
BOT_ADMIN_USER=botadmin
# GENERATED. Shared between Caddy and the bot: Caddy adds it as a header on the
# admin route only, which is how the app knows the request passed basic auth.
BOT_ADMIN_KEY=

# ------------------------------------------------------------------- ports ---

HTTP_PORT=80
HTTPS_PORT=443
# Caddy's own HTTPS server, behind the layer4 SNI router. Internal to the
# container; change only if it collides with something inside the network.
CADDY_INTERNAL_HTTPS=9443

# Loopback debug ports. Set to 127.0.0.1 to keep them local (recommended).
BIND_LOCAL=127.0.0.1
NEXTCLOUD_LOCAL_PORT=8081
IMMICH_LOCAL_PORT=2283
ELEMENT_LOCAL_PORT=8082
METUBE_LOCAL_PORT=8083
SYNAPSE_LOCAL_PORT=8008

# Matrix call media. 7881/tcp + 7882/udp must be forwarded on your router.
# Kept below the ephemeral range on purpose, to avoid bind collisions.
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882
COTURN_PORT=3478
COTURN_RELAY_MIN=49160
COTURN_RELAY_MAX=49200

# --------------------------------------------------------------- versions ----
#
# Pinned on purpose. Never use :latest for anything stateful — Nextcloud needs
# sequential major upgrades and an unattended jump will break it.

NEXTCLOUD_IMAGE=nextcloud:34-apache
NEXTCLOUD_DB_IMAGE=mariadb:11.4
NEXTCLOUD_REDIS_IMAGE=redis:7-alpine
IMMICH_VERSION=v3
IMMICH_DB_IMAGE=ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0
IMMICH_REDIS_IMAGE=docker.io/valkey/valkey:9
SYNAPSE_IMAGE=ghcr.io/element-hq/synapse:latest
MATRIX_DB_IMAGE=postgres:16-alpine
ELEMENT_IMAGE=vectorim/element-web:latest
COTURN_IMAGE=coturn/coturn:latest
LIVEKIT_IMAGE=livekit/livekit-server:v1.8
LIVEKIT_JWT_IMAGE=ghcr.io/element-hq/lk-jwt-service:latest
METUBE_IMAGE=ghcr.io/alexta69/metube:latest
STATS_IMAGE=python:3.12-slim

# --------------------------------------------------------------- Nextcloud ---

NEXTCLOUD_ADMIN_USER=admin
# GENERATED
NEXTCLOUD_ADMIN_PASSWORD=
# GENERATED
NEXTCLOUD_DB_PASSWORD=
# GENERATED
NEXTCLOUD_DB_ROOT_PASSWORD=
NEXTCLOUD_UPLOAD_LIMIT=16G
NEXTCLOUD_MEMORY_LIMIT=1G
# Docker's default bridge range. Nextcloud must trust the proxy or every
# redirect and generated URL comes out wrong.
TRUSTED_PROXIES=172.16.0.0/12

# ------------------------------------------------------------------ Immich ---

DB_USERNAME=immich
DB_DATABASE_NAME=immich
# GENERATED
DB_PASSWORD=
# Immich's own compose reads these names; keep them in sync with the above.
UPLOAD_LOCATION=${IMMICH_UPLOAD}
DB_DATA_LOCATION=${IMMICH_DB_DATA}

# ------------------------------------------------------------------ Matrix ---

# GENERATED
MATRIX_DB_PASSWORD=
# GENERATED
COTURN_SECRET=
# GENERATED
SYNAPSE_REGISTRATION_SECRET=
# GENERATED
SYNAPSE_MACAROON_SECRET=
# GENERATED
SYNAPSE_FORM_SECRET=
# GENERATED
LIVEKIT_KEY=
# GENERATED
LIVEKIT_SECRET=

# Federation is OFF by default: the homeserver talks to nobody else, which is
# usually what you want for a private messenger. Set to "true" to allow it.
MATRIX_FEDERATION=false
# Open registration is a spam magnet. Leave closed and add users with:
#   docker exec matrix_synapse register_new_matrix_user -c /data/homeserver.yaml
MATRIX_OPEN_REGISTRATION=false
ELEMENT_BRAND="Chat"
# Phone-number country pre-selection in Element (ISO 3166-1 alpha-2).
ELEMENT_COUNTRY_CODE=NO

# ------------------------------------------------------------------ MeTube ---

# Minutes before a finished download is auto-deleted from the root of the
# download dir. Files moved into keep/ are never purged. 720 = 12h.
METUBE_TTL_MIN=720

# ----------------------------------------------------------- AmneziaWG VPN ---
#
# Separate compose project in ./amneziawg — run it from inside that directory.
# It is deliberately NOT part of this stack, so a mistake there cannot recreate
# caddy or immich. See docs/VPN.md.

AWG_PORT=20443
AWG_SUBNET=10.8.2.0/24
AWG_SERVER_IP=10.8.2.1
AWG_MTU=1280
# Defaults to BASE_DOMAIN. Point clients somewhere else (a bare IP, a second
# domain) if you don't want the VPN endpoint tied to the web hostname.
AWG_ENDPOINT=${BASE_DOMAIN}
# Web UI login. The password is stored in Caddy as a bcrypt hash, generated by
# bootstrap.sh; the plaintext is written once to ./secrets/awg-admin-password.
AWG_ADMIN_USER=awgadmin

# Login for the crypto tracker UI. Password is generated into
# secrets/crypto-admin-password by bootstrap.sh.
CRYPTO_ADMIN_USER=cryptoadmin
# How many days of 1-minute candles and alert history to keep.
CRYPTO_RETENTION_DAYS=45
CRYPTO_LOCAL_PORT=8084
# Telegram delivery for alerts. Optional here: they can also be entered in the
# tracker's Telegram tab. Set here, they override and lock the UI fields.
CRYPTO_TG_TOKEN=
CRYPTO_TG_CHAT_ID=

# ESP32 sensor dashboard (profile `sensor`). The token is generated by
# bootstrap.sh; put the same value in SENSOR_TOKEN in the device's secrets.py.
SENSOR_TOKEN=
SENSOR_LOCAL_PORT=8085
# "Why did it move": after a volatility alert, the tracker asks n8n to explain
# it and the answer arrives as a reply under the alert. Needs the n8n profile
# and the crypto-move-explainer workflow imported (docs/CRYPTO.md). Then set:
#   CRYPTO_EXPLAIN_HOOK=http://n8n:5678/webhook/crypto-move
CRYPTO_EXPLAIN_HOOK=
# Sent as header X-Hook-Secret; the n8n webhook checks it. bootstrap.sh generates it.
CRYPTO_EXPLAIN_SECRET=

# ------------------------------------------------------- helper bot -----
#
# Telegram bot for the hub (docs/HELPER.md). Token from @BotFather.
HELPER_BOT_TOKEN=
# Optional second bot (also from @BotFather) that members use instead of this one:
# the helper bot stays your private ops bot and tells everyone else where to go.
# Empty = one bot for everyone. Or paste it later on the admin Bots page, which
# wins over this value. Must be a different bot than HELPER_BOT_TOKEN.
MEMBER_BOT_TOKEN=
# Your numeric Telegram user id -- the only account that can request logins.
# Unknown? Leave empty, message the bot: it replies with your id.
HELPER_OWNER_ID=
# Hour (server time) of the daily health report; empty disables it.
HELPER_REPORT_HOUR=9
HELPER_LOCAL_PORT=8086

# --- Membership system (docs/HELPER.md "Members") ---
#
# Strangers need an access code, which you mint in the bot or on the admin page.
# A code gives a member a subscription (default 30 days) to: a VPN subscription
# link (3x-ui), an account on your Matrix server, and optionally the bot's own
# tools. When it runs out the services stop; accounts and settings are kept.
#
# Telegram @handle people are told to write to ("No code? Write @you"). Empty
# -> the bot and Mini App just say "contact the owner".
OWNER_CONTACT=
#
# VPN for members needs a 3x-ui API token (panel -> Settings -> API token).
# Optional: without it the VPN screens say "not configured" and everything
# else works. Needs the 3x-ui panel (docs/VPN.md) to be running.
XUI_API_TOKEN=
# Where the Bots page hands a new crypto-bot token to the tracker (profile `crypto`).
# The default is right unless you renamed the service.
# CRYPTO_URL=http://crypto:9102/api/settings
# Defaults to https://host.docker.internal:${XUI_PANEL_PORT}/${XUI_PANEL_PATH}.
# The panel's TLS chain is verified but the hostname is not, so the panel's
# Let's Encrypt cert (scripts/3xui-cert-sync.sh) is what makes this work. If the
# panel serves plain HTTP, use http://host.docker.internal:PORT/PATH here.
# XUI_URL=
# Subscription link base given to members; the subId is appended. Defaults to
# https://${BASE_DOMAIN}/sub/ (Caddy proxies it to the panel on :443).
# VPN_SUB_BASE=
#
# Matrix accounts for members need an admin user on your Synapse. Create one:
#   docker compose exec matrix-synapse register_new_matrix_user \
#       -c /data/homeserver.yaml -a -u admin
# then put its name (localpart) and password here. Optional: empty -> the
# Matrix screens say "not configured".
MATRIX_ADMIN_USER=
MATRIX_ADMIN_PASSWORD=
# Defaults to BASE_DOMAIN (the Matrix server_name; user IDs are @name:server_name).
# MATRIX_SERVER_NAME=
# Accounts one member may create.
MATRIX_MAX_PER_MEMBER=2

# ------------------------------------------------ n8n + local LLM -----
#
# Profiles: `n8n` for the automation UI, `ollama` for a local model runtime
# it can call as http://ollama:11434. See docs/N8N.md.

N8N_IMAGE=n8nio/n8n:2.41.2
N8N_LOCAL_PORT=5678
# Encrypts every credential n8n stores. bootstrap.sh generates it; back it
# up together with n8n/data or the saved credentials cannot be decrypted.
N8N_ENCRYPTION_KEY=

OLLAMA_IMAGE=ollama/ollama:0.20.3
# Model files are large (a 8B model is ~5 GB) -- keep them off the system
# disk. Enable the GPU with docker-compose.gpu.yml; on CPU it still works,
# just slowly.
OLLAMA_MODELS=${DATA_ROOT}/ollama
# How long a model stays resident in VRAM after its last request.
OLLAMA_KEEP_ALIVE=5m

# ------------------------------------------------------- 3x-ui VPN panel -----
#
# Optional second VPN (VLESS/Reality, Hysteria2, Shadowsocks). Separate compose
# project in ./3xpanel, host networking. See docs/VPN.md.

XUI_PANEL_PORT=10358
# GENERATED -> panel-<random>
XUI_PANEL_PATH=panel
XUI_SUB_PORT=2096
# The panel image is pinned by digest in 3xpanel/docker-compose.yml (3.8.5,
# Xray 26.9.9). Upgrade with scripts/3xui-upgrade.sh, not by editing this.
# XUI_IMAGE=

# --- VPN inbounds riding :443 -------------------------------------------------
#
# Off by default. When on, Caddy's layer4 router matches these two SNI names on
# :443 and passes the RAW TLS stream to a VPN inbound on the host — no TLS
# termination, because Reality does its own. This lets VPN configs use 443,
# which nothing blocks, with no extra router port-forward.
#
# The SNI names must match what you configured in the panel, and must be names
# nothing else on this server serves. Re-run ./bootstrap.sh after changing.
VPN_PASSTHROUGH=false
VPN_SNI_A=www.icloud.com
VPN_PORT_A=57971
VPN_SNI_B=dl.google.com
VPN_PORT_B=59200

# --- naming -------------------------------------------------------------------
# Compose project names and the shared docker network. Change only if you run
# two copies of this stack on one host.
STACK_NAME=meowstack
PROXY_NETWORK=meowstack-proxy
AWG_PROJECT_NAME=meowstack-awg
XUI_PROJECT_NAME=meowstack-xui

# Host user that owns bind-mounted data (Synapse config, MeTube downloads).
# `id -u` / `id -g` for the user running the stack.
PUID=1000
PGID=1000
